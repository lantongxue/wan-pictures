# ==============================================================================
# Wan Pictures (万图) Golang + Gin + GORM Backend Environment Configuration
# ==============================================================================

# Server Port
PORT=8080

# Gin Running Mode: 'debug', 'release', 'test'
GIN_MODE=release

# Database Driver: 'sqlite', 'mysql', 'postgres'
DB_DRIVER=sqlite

# Database DSN Connection String
# For SQLite:
DB_DSN=wanpictures.db
# For MySQL:
# DB_DSN=root:password@tcp(127.0.0.1:3306)/wanpictures?charset=utf8mb4&parseTime=True&loc=Local
# For PostgreSQL:
# DB_DSN=host=localhost user=postgres password=postgres dbname=wanpictures port=5432 sslmode=disable TimeZone=Asia/Shanghai

# JWT Secret Key for Authentication Tokens
JWT_SECRET=wanpictures_super_secret_jwt_key_2026_change_in_production

# JWT Token Expiration in Hours
JWT_EXPIRE_HOURS=72
